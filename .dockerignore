# .dockerignore
# Files and directories to ignore in Docker build

# Git
.git
.gitignore

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SvelteKit
.svelte-kit
build

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Logs
logs
*.log

# Test
coverage
.nyc_output

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Prisma (generated client will be regenerated)
prisma/migrations

# Misc
*.md
!README.md